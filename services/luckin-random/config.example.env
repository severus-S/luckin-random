# Copy to ignored .env; Node --env-file=.env dist/src/main.js
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.local/luckin.sqlite
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
ENCRYPTION_KEY=
# Mock is the default. Live queries require a token entered through authenticated HTTPS settings.
MCP_MODE=mock
ALLOW_LIVE_ORDERS=false
# Keep false until actual response mappings and payment handoff are reviewed against live evidence.
LIVE_CONTRACT_VERIFIED=false
# TLS termination must be configured before exposing the backend; never enable this on a public listener.
ALLOW_LOOPBACK_HTTP=true
